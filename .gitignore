# ========================================================
# Unity 2D Framework .gitignore
# 原则：只忽略「临时 / 自动生成 / 个人本地」文件
# 必须提交：Assets(含全部 .meta)、Packages、ProjectSettings
# ========================================================

# ---------- Unity 自动生成的临时目录 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Unity 崩溃 / 诊断输出
sysinfo.txt
crashlytics-build.properties

# ---------- IDE / 编辑器自动生成 ----------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.tmp
*.bak

# Rider 自动写入 Assets 的插件目录
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ---------- 构建产物 ----------
*.apk
*.aab
*.app
*.ipa
*.exe
/[Ee]xported[Oo]bj/

# ---------- 操作系统文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ========================================================
# 显式保留（防止被子规则误伤）
# ========================================================
!/[Aa]ssets/
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/
!/[Pp]ackages/**/*
!/[Pp]roject[Ss]ettings/
!/[Pp]roject[Ss]ettings/**/*
!/package.json